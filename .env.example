# Discord bot token. There is ONE variable set: a local checkout holds the DEV
# bot's token and the local database; prod values live only in the Railway
# service variables and never on a developer machine. The config profile
# (test vs prod wiring) is derived from the token's own application id in
# Helpers/variables.py — there is no mode flag to get wrong.
TOKEN=

# Config profile override — only honored when TOKEN is unset (pytest, offline
# scripts). With a token present, the token's identity always wins.
# BOT_PROFILE=test

# Database (local dev Postgres; prod points at its own DB via Railway vars)
DB_LOGIN=
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tortreborn
DB_SSLMODE=disable

# Wynncraft
WYNN_TOKEN=
RECRUITMENT_TOKEN=
WYNN_LOOP_TOKEN=
visage_UA=

# Wynnventory
WYNNVENTORY_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Sheets
SHEETS_SCRIPT_URL=

# Application System (shared secret with website)
APPLICATION_TOKEN_SECRET=

# Railway Bucket storage (S3 protocol). Keys are PER BUCKET: local dev uses the
# storage-dev bucket's credentials; prod (Railway service vars) uses storage-prod's.
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET_NAME=

# Error Notifications (your Discord user ID — who gets pinged on bot errors)
ERROR_PING_USER_ID=

# Latency telemetry (Phase 0 instrumentation) — set to 0 to disable stdout timing records
LATENCY_TELEMETRY=1

# Legacy Shell Exchange Webhook
LEGACY_WEBHOOK_URL=
